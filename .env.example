# ==============================================================================
# DAEBAK.TIX - OAUTH & SOCIAL LOGIN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your OAuth credentials.
# ==============================================================================

# NextAuth Core Settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here_change_in_production

# Google OAuth Provider (Obtain from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook / Meta OAuth Provider (Obtain from https://developers.facebook.com/)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# TikTok OAuth Provider (Obtain from https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
